NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# "Doorgaan met Facebook": de Meta-app. Met META_LOGIN_CONFIG_ID een configuratie van Facebook Login for Business.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_API_VERSION=v24.0
# Optioneel: de sleutel van een systeemgebruiker, voor wie (nog) niet met Facebook koppelde (alleen op de server).
# META_TOKEN (de naam uit agency-hub) werkt ook.
META_SYSTEM_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
ANTHROPIC_API_KEY=
STUDIO_IMAGE_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
# Afzender en testverzending (packages/mails). Zonder RESEND_API_KEY gaan mails naar het postvak (/mails in de demo).
MAIL_FROM=AdSweet <hallo@adsweet.ai>
MAIL_MODE=
MAIL_OUTBOX_DIR=
# Geheim voor de dagelijkse taak /api/cron/dagelijks (Vercel Cron stuurt het als Bearer-token).
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://adsweet.ai
TESTFASE=false
